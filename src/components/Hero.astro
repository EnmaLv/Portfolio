---
---
<section
  id="hero"
  class="halftone relative min-h-screen flex items-center"
  style="padding-top: 64px; overflow: hidden;"
>
  <div style="position: absolute; top: 15%; left: -10%; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, rgba(122,0,255,0.12) 0%, transparent 70%); pointer-events: none;"></div>
  <div style="position: absolute; bottom: 10%; right: -5%; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(255,0,60,0.1) 0%, transparent 70%); pointer-events: none;"></div>

  <div class="max-w-7xl mx-auto px-6 w-full grid md:grid-cols-2 gap-12 items-center py-20">
    <div>
      <div class="reveal" style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 8px var(--color-cyan); animation: pulse-ring 2s ease-out infinite;"></span>
        <span class="section-label" style="color: var(--color-cyan);" data-es="Disponible para misiones" data-en="Available for Development">Disponible para el Desarrollo</span>
      </div>

      <h1
        class="hero-title reveal reveal-delay-1"
        style="font-size: clamp(2.5rem, 5vw, 4.75rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 1.5rem; white-space: pre-line;"
        data-es="Desarrollador&#10;Fullstack"
        data-en="Fullstack&#10;Developer"
        >Desarrollador<br />Fullstack</h1>

      <div class="reveal reveal-delay-2" style="margin-bottom: 1.5rem;">
        <span class="accent-line"></span>
      </div>

      <p
        class="text-muted reveal reveal-delay-3"
        style="font-size: clamp(1rem, 1.5vw, 1.125rem); line-height: 1.75; max-width: 480px; margin-bottom: 2.5rem;"
        data-es="Mi superpoder es convertir el código en soluciones reales tejiendo arquitectura sólida con diseño de alto impacto."
        data-en="My superpower is turning code into real solutions weaving solid architecture with high-impact design."
      >
        Mi superpoder es convertir el código en soluciones reales tejiendo arquitecturas sólidas con diseño de alto impacto.
      </p>

      <div class="reveal reveal-delay-4 flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto">
        <a href="#projects" class="btn-crimson w-full sm:w-auto justify-center">
          <span data-es="Ver Proyectos" data-en="View Projects">Ver Proyectos</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a href="#contact" class="btn-secondary-custom w-full sm:w-auto justify-center">
          <span data-es="Contactar" data-en="Get In Touch">Contactar</span>
        </a>
      </div>

      <div class="reveal reveal-delay-5" style="display: flex; gap: 2.5rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.06);">
        <div>
          <div style="font-family: var(--font-display); font-size: 2rem; font-weight: 900; color: var(--color-crimson); line-height: 1;">2+</div>
          <div class="text-muted" style="font-size: 0.75rem; margin-top: 0.25rem; letter-spacing: 0.04em;" data-es="Años exp." data-en="Yrs exp.">Años exp.</div>
        </div>
        <div>
          <div style="font-family: var(--font-display); font-size: 2rem; font-weight: 900; color: var(--color-crimson); line-height: 1;">100%</div>
          <div class="text-muted" style="font-size: 0.75rem; margin-top: 0.25rem; letter-spacing: 0.04em;" data-es="Dedicación" data-en="Dedication">Dedicación</div>
        </div>
      </div>
    </div>

    <div class="hidden md:flex reveal reveal-delay-3" style="align-items: center; justify-content: center; position: relative;">
      <div class="portal-float" style="position: relative; width: 380px; height: 380px; max-width: 90vw;">
        <svg class="spin-slow" style="position: absolute; inset: 0; width: 100%; height: 100%;" viewBox="0 0 380 380" fill="none">
          <circle cx="190" cy="190" r="180" stroke="rgba(122,0,255,0.2)" stroke-width="1" stroke-dasharray="6 4" />
          <circle cx="190" cy="190" r="160" stroke="rgba(0,217,255,0.15)" stroke-width="1" stroke-dasharray="3 6" />
        </svg>

        <div class="portal-ring" style="position: absolute; inset: 0px; border-radius: 50%; border: 1px solid var(--color-violet);"></div>
        <div class="portal-ring" style="position: absolute; inset: 20px; border-radius: 50%; border: 1px solid var(--color-cyan); animation-delay: 0.7s;"></div>
        <div class="portal-ring" style="position: absolute; inset: 40px; border-radius: 50%; border: 1px solid var(--color-crimson); animation-delay: 1.4s;"></div>

        <div style="position: absolute; inset: 80px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(0,217,255,0.5), rgba(122,0,255,0.6) 50%, rgba(255,0,60,0.4)); box-shadow: 0 0 60px rgba(0,217,255,0.3), 0 0 120px rgba(122,0,255,0.2), inset 0 0 40px rgba(255,255,255,0.1);"></div>

        <svg style="position: absolute; inset: 40px; width: calc(100% - 80px); height: calc(100% - 80px);" viewBox="0 0 300 300" fill="none">
          <polygon points="150,30 270,210 30,210" stroke="rgba(0,217,255,0.25)" stroke-width="1" fill="none" />
          <polygon points="150,270 30,90 270,90" stroke="rgba(122,0,255,0.25)" stroke-width="1" fill="none" />
          <circle cx="150" cy="150" r="60" stroke="rgba(255,0,60,0.2)" stroke-width="1" stroke-dasharray="4 4" />
          <line x1="150" y1="30" x2="150" y2="270" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
          <line x1="30" y1="150" x2="270" y2="150" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
        </svg>
      </div>
    </div>
  </div>
</section>