---
const projects = [
    {
    id: 'bienestar',
    title: 'SIGA - Bienestar Estudiantil',
    subtitle: 'Intranet Modular Universitaria',
    descES: 'Ecosistema centralizado que unifica 5 áreas críticas (Comedor, Salud, Deportes, Becas y Transporte) con control de inventario en tiempo real, trazabilidad por auditoría y seguridad RBAC.',
    descEN: 'Centralized ecosystem unifying 5 core areas (Dining, Health, Sports, Scholarships & Transit) with real-time inventory, audit logs, and RBAC security.',
    stack: ['Laravel', 'MySQL', 'Tailwind', 'Blade', 'Docker', 'JavaScript', 'PHP', 'Alpine', 'Livewire', 'Pusher', 'Aiven'], 
    gradient: 'linear-gradient(135deg, rgba(122,0,255,0.6) 0%, rgba(10,10,15,0.9) 60%)',
    accent: 'var(--color-violet)',
    size: 'large',
    image: '/images/be1.webp',
    github: 'https://github.com/EnmaLv/SisgestiondeInventario',
  },
  {
    id: 'moove',
    title: 'Moove',
    subtitle: 'Transporte Inteligente',
    descES: 'App móvil institucional para el rastreo de rutas universitarias en tiempo real por GPS, validación de asistencia por proximidad y control de flota.',
    descEN: 'Institutional Uber-style mobile app for real-time university bus GPS tracking, proximity attendance validation, and fleet management.',
    stack: ['Flutter', 'Dart', 'Firebase', 'GPS', 'SQLite'],
    gradient: 'linear-gradient(135deg, rgba(0,217,255,0.4) 0%, rgba(10,10,15,0.9) 60%)',
    accent: 'var(--color-cyan)',
    size: 'small',
    image: '/images/moove.png',
    github: 'https://github.com/EnmaLv/Moove',
  },
  {
    id: 'banagro',
    title: 'Banagro',
    subtitle: 'Next.js 15 + Framer Motion',
    descES: 'Landing page para una institución bancaria agrícola en Venezuela. Incluye diseño de alta conversión, estimador interactivo de créditos y animaciones fluidas.',
    descEN: 'Agro-finance landing page for a new agricultural bank in Venezuela. Features interactive loan estimator and fluid animations.',
    stack: ['Next.js', 'Tailwind', 'Framer Motion', 'TS'],
    gradient: 'linear-gradient(135deg, rgba(16, 185, 129, 0.35) 0%, rgba(10, 10, 15, 0.9) 60%)',
    accent: '#10b981',
    size: 'small',
    image: '/images/banagro.png',
    github: null, // Proyecto privado
    }
]
---
<section id="projects" style="padding: clamp(5rem, 10vw, 8rem) 0;">
  <div class="max-w-7xl mx-auto px-6">
    <div class="reveal" style="margin-bottom: 3.5rem;">
      <span class="section-label" data-es="Misiones de Código" data-en="Code Missions">Misiones de Código</span>
      <span class="accent-line" style="margin-top: 0.75rem;"></span>
      <h2
        style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -0.02em; margin: 1rem 0 0; line-height: 1.1;"
        data-es="Proyectos"
        data-en="Projects"
      >
        Proyectos
      </h2>
    </div>

    <!-- Bento Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
      {projects.map((p, i) => (
        <div class={`reveal reveal-delay-${i + 1}`} style={p.size === 'large' ? 'grid-column: span 2;' : ''}>
          <div
            class="project-card surface"
            style={`min-height: ${p.size === 'large' ? '380px' : '280px'}; display: flex; flex-direction: column; justify-content: flex-end; position: relative; border-radius: 1rem; overflow: hidden;`}
          >
            <!-- Background Gradient fallback -->
            <div style={`position: absolute; inset: 0; background: ${p.gradient}; border-radius: 1rem;`}></div>

            <!-- Project Image with zoom effect -->
            {p.image && (
              <img
                src={p.image}
                alt={p.title}
                class="project-bg-img"
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; transition: transform 0.5s ease, opacity 0.5s ease;"
              />
            )}

            <!-- Dark Overlay for text legibility -->
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,15,0.95) 15%, rgba(10,10,15,0.4) 100%);"></div>

            <!-- Grid pattern -->
            <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 32px 32px; border-radius: 1rem;"></div>
            
            <!-- Accent Dot -->
            <div style={`position: absolute; top: 1.5rem; left: 1.5rem; width: 8px; height: 8px; border-radius: 50%; background: ${p.accent}; box-shadow: 0 0 12px ${p.accent}; z-index: 2;`}></div>

            <!-- Stack Badges -->
            <div style="position: absolute; top: 1.25rem; right: 1.25rem; display: flex; gap: 0.375rem; flex-wrap: wrap; justify-content: flex-end; max-width: 60%; z-index: 2;">
              {p.stack.map(s => (
                <span style={`font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: 0.25rem; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); border: 1px solid ${p.accent}44; color: rgba(255,255,255,0.85);`}>
                  {s}
                </span>
              ))}
            </div>

            <!-- Card Content -->
            <div style="position: relative; padding: 1.5rem; z-index: 2;">
              <p style={`font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: ${p.accent}; margin-bottom: 0.3rem;`}>
                {p.subtitle}
              </p>
              <h3 style={`font-family: var(--font-display); font-size: ${p.size === 'large' ? '1.75rem' : '1.25rem'}; font-weight: 700; line-height: 1.2; margin: 0 0 0.75rem;`}>
                {p.title}
              </h3>
              <p class="text-muted" style="font-size: 0.82rem; line-height: 1.7; max-width: 480px;" data-es={p.descES} data-en={p.descEN}>
                {p.descES}
              </p>
            </div>

            <!-- Hover overlay -->
            <div class="overlay">
              <p style="font-size: 0.9rem; font-weight: 700; letter-spacing: 0.04em; color: #ffffff; margin-bottom: 0.25rem;">
                {p.title}
              </p>
              <a href={p.github} target="_blank" rel="noreferrer" class="btn-overlay btn-overlay-secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
                <span data-es="Ver Código" data-en="View Code">Ver Código</span>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>