---
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projectsData } from "../../data/projects";
import "../../styles/index.css";

export function getStaticPaths() {
  return Object.keys(projectsData).map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const project = projectsData[slug];

const slugs = Object.keys(projectsData);
const currentIndex = slugs.indexOf(slug);
const prevSlug = currentIndex > 0 ? slugs[currentIndex - 1] : null;
const nextSlug = currentIndex < slugs.length - 1 ? slugs[currentIndex + 1] : null;
const prevProject = prevSlug ? projectsData[prevSlug] : null;
const nextProject = nextSlug ? projectsData[nextSlug] : null;

const galleryItems = Array.from({ length: project.gallery }, (_, i) => i + 1);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} | EnmaDev</title>
    <meta name="description" content={`${project.title} — ${project.subtitle}. ${project.intro}`} />

    <script is:inline>
      const savedTheme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.setAttribute("data-theme", savedTheme);
    </script>
  </head>
  <body>
    <Nav />

    <main class="max-w-5xl mx-auto px-6" style="padding-top: 7rem; padding-bottom: 6rem;">

      <!-- ============================================================ -->
      <!-- HERO                                                         -->
      <!-- ============================================================ -->
      <a
        href="/#projects"
        class="nav-link reveal visible"
        style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; font-size: 0.8rem;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        <span data-es="Volver a Proyectos" data-en="Back to Projects">Volver a Proyectos</span>
      </a>

      <header class="reveal visible" style="margin-bottom: 2.5rem; position: relative;">
        <div style={`position: absolute; inset: -3rem -2rem -2rem -2rem; background: ${project.gradient}; opacity: 0.35; filter: blur(60px); z-index: -1; border-radius: 50%; pointer-events: none;`}></div>

        <span class="section-label" style={`color: ${project.accent};`}>{project.subtitle}</span>

        <h1
          style="font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 900; margin: 0.75rem 0 1.5rem; line-height: 1.05; letter-spacing: -0.02em;"
        >
          {project.title}
        </h1>

        <!-- Meta chips -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.75rem;">
          <span class="meta-chip">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {project.role}
          </span>
          <span class="meta-chip">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {project.period}
          </span>
          <span class="meta-chip">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>
            {project.context}
          </span>
        </div>

        <!-- CTA buttons -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noreferrer" class="cta-btn cta-primary" style={`border-color: ${project.accent}55; background: ${project.accent}15;`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span data-es="Ver Demo" data-en="View Demo">Ver Demo</span>
            </a>
          )}
          {project.github && !project.isPrivate && (
            <a href={project.github} target="_blank" rel="noreferrer" class="cta-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span data-es="Ver Código" data-en="View Code">Ver Código</span>
            </a>
          )}
          {project.isPrivate && (
            <span class="cta-btn" style="cursor: default; opacity: 0.6;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span data-es="Repositorio privado" data-en="Private repository">Repositorio privado</span>
            </span>
          )}
        </div>
      </header>

      <!-- ============================================================ -->
      <!-- MÉTRICAS                                                     -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem;">
          {project.metrics.map((m) => (
            <div class="surface" style={`padding: 1.25rem 1rem; border-radius: 0.75rem; text-align: center; border-top: 2px solid ${project.accent};`}>
              <div style={`font-family: var(--font-display); font-size: 1.9rem; font-weight: 900; color: ${project.accent}; line-height: 1;`}>{m.value}</div>
              <div style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-top: 0.4rem;">
                {m.label}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- INTRO                                                        -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <p style="font-size: 1.05rem; line-height: 1.85; color: rgba(255,255,255,0.85);">
          {project.intro}
        </p>
      </section>

      <!-- ============================================================ -->
      <!-- EL RETO                                                      -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
          <span style={`width: 32px; height: 2px; background: ${project.accent};`}></span>
          <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin: 0;" data-es="El Reto" data-en="The Challenge">El Reto</h2>
        </div>
        <div class="surface" style={`padding: 1.5rem 1.75rem; border-radius: 0.75rem; border-left: 3px solid ${project.accent};`}>
          <p class="text-muted" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">{project.challenge}</p>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- LO QUE CONSTRUÍ                                              -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style={`width: 32px; height: 2px; background: ${project.accent};`}></span>
          <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin: 0;" data-es="Lo que construí" data-en="What I built">Lo que construí</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {project.features.map((f) => (
            <div class="surface" style="padding: 1.25rem; border-radius: 0.75rem;">
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <span style={`flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; background: ${project.accent}; margin-top: 0.45rem; box-shadow: 0 0 10px ${project.accent};`}></span>
                <div>
                  <h3 style="font-size: 0.92rem; font-weight: 700; margin: 0 0 0.35rem; line-height: 1.35;">{f.t}</h3>
                  <p class="text-muted" style="font-size: 0.82rem; line-height: 1.65; margin: 0;">{f.d}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- DECISIONES TÉCNICAS                                          -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style={`width: 32px; height: 2px; background: ${project.accent};`}></span>
          <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin: 0;" data-es="Decisiones técnicas" data-en="Technical decisions">Decisiones técnicas</h2>
        </div>

        <ol style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.875rem;">
          {project.decisions.map((d, i) => (
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style={`flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: ${project.accent}22; border: 1px solid ${project.accent}55; color: ${project.accent}; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 0.75rem; font-weight: 800; margin-top: 0.1rem;`}>
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="text-muted" style="font-size: 0.9rem; line-height: 1.7; margin: 0;">{d}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ============================================================ -->
      <!-- STACK                                                        -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style={`width: 32px; height: 2px; background: ${project.accent};`}></span>
          <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin: 0;" data-es="Stack Tecnológico" data-en="Tech Stack">Stack Tecnológico</h2>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {project.stack.map((s) => (
            <span style={`font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.45rem 0.85rem; border-radius: 999px; background: rgba(255,255,255,0.05); border: 1px solid ${project.accent}44; color: rgba(255,255,255,0.9);`}>
              {s}
            </span>
          ))}
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- GALERÍA (responsive: 2 cols móvil, 3 cols desktop)           -->
      <!-- ============================================================ -->
      <section class="reveal visible" style="margin-bottom: 4rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style={`width: 32px; height: 2px; background: ${project.accent};`}></span>
          <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin: 0;" data-es="Vistas del sistema" data-en="System views">Vistas del sistema</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
          {galleryItems.map((n) => (
            <button
              type="button"
              class="gallery-item"
              data-lightbox-src={`/images/projects/${slug}/${n}.webp`}
              data-lightbox-alt={`Captura ${n} de ${project.title}`}
              aria-label={`Ampliar captura ${n} de ${project.title}`}
              style="aspect-ratio: 16 / 10; border-radius: 0.75rem; overflow: hidden; position: relative; background: rgba(255,255,255,0.03); padding: 0; border: 0; cursor: zoom-in;"
            >
              <img
                src={`/images/projects/${slug}/${n}.webp`}
                alt={`Captura ${n} de ${project.title}`}
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease;"
              />
            </button>
          ))}
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- PREV / NEXT                                                  -->
      <!-- ============================================================ -->
      {(prevProject || nextProject) && (
        <section class="reveal visible" style="margin-top: 5rem; padding-top: 2.5rem; border-top: 1px solid rgba(255,255,255,0.08);">
          <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 1.25rem;" data-es="Seguir explorando" data-en="Keep exploring">
            Seguir explorando
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {prevProject && prevSlug && (
              <a href={`/projects/${prevSlug}`} class="surface nav-project-card" style="padding: 1.25rem; border-radius: 0.75rem; display: flex; align-items: center; gap: 1rem; text-decoration: none; color: inherit; transition: border-color 0.3s ease, transform 0.3s ease;">
                <span style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </span>
                <div style="min-width: 0;">
                  <div style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.15rem;">Anterior</div>
                  <div style="font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{prevProject.title}</div>
                </div>
              </a>
            )}
            {nextProject && nextSlug && (
              <a href={`/projects/${nextSlug}`} class="surface nav-project-card" style="padding: 1.25rem; border-radius: 0.75rem; display: flex; align-items: center; gap: 1rem; text-decoration: none; color: inherit; text-align: right; justify-content: flex-end; transition: border-color 0.3s ease, transform 0.3s ease;">
                <div style="min-width: 0;">
                  <div style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.15rem;">Siguiente</div>
                  <div style="font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{nextProject.title}</div>
                </div>
                <span style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            )}
          </div>
        </section>
      )}

    </main>

    <Footer />

    <!-- ============================================================ -->
    <!-- LIGHTBOX                                                     -->
    <!-- ============================================================ -->
    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Vista ampliada de imagen"
    >
      <button type="button" class="lightbox-close" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button type="button" class="lightbox-nav lightbox-prev" aria-label="Imagen anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <img id="lightbox-img" src="" alt="" />

      <button type="button" class="lightbox-nav lightbox-next" aria-label="Imagen siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div id="lightbox-counter" class="lightbox-counter"></div>
    </div>
    <script is:inline>
      (function () {
        const items = Array.from(document.querySelectorAll("[data-lightbox-src]"));
        const lb = document.getElementById("lightbox");
        if (!items.length || !lb) return;

        const img = document.getElementById("lightbox-img");
        const counter = document.getElementById("lightbox-counter");
        const btnPrev = lb.querySelector(".lightbox-prev");
        const btnNext = lb.querySelector(".lightbox-next");
        const btnClose = lb.querySelector(".lightbox-close");

        let current = 0;
        const isSingle = items.length <= 1;
        btnPrev.style.display = isSingle ? "none" : "";
        btnNext.style.display = isSingle ? "none" : "";

        function open(i) {
          current = i;
          const el = items[i];
          img.src = el.getAttribute("data-lightbox-src");
          img.alt = el.getAttribute("data-lightbox-alt") || "";
          counter.textContent = `${i + 1} / ${items.length}`;
          lb.classList.add("open");
          lb.setAttribute("aria-hidden", "false");
          document.body.classList.add("lightbox-open");
        }

        function close() {
          lb.classList.remove("open");
          lb.setAttribute("aria-hidden", "true");
          document.body.classList.remove("lightbox-open");
          img.src = "";
        }

        function next() { open((current + 1) % items.length); }
        function prev() { open((current - 1 + items.length) % items.length); }

        items.forEach((el, i) => el.addEventListener("click", () => open(i)));
        btnClose.addEventListener("click", close);
        btnNext.addEventListener("click", next);
        btnPrev.addEventListener("click", prev);

        // Click en el fondo oscuro cierra
        lb.addEventListener("click", (e) => {
          if (e.target === lb) close();
        });

        // Teclado: ESC cierra, flechas navegan
        document.addEventListener("keydown", (e) => {
          if (!lb.classList.contains("open")) return;
          if (e.key === "Escape") close();
          else if (e.key === "ArrowRight") next();
          else if (e.key === "ArrowLeft") prev();
        });

        // Swipe básico en móvil
        let touchX = 0;
        lb.addEventListener("touchstart", (e) => {
          touchX = e.touches[0].clientX;
        }, { passive: true });
        lb.addEventListener("touchend", (e) => {
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 60 && !isSingle) {
            if (dx < 0) next();
            else prev();
          }
        }, { passive: true });
      })();
    </script>
    <script src="../../scripts/main.js"></script>

    <!-- Estilos específicos de la página de detalle -->
    <style is:global>
      .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7);
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.25rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-decoration: none;
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
      }

      .cta-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-1px);
      }

      .nav-project-card:hover {
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
      }

      /* ---------- Galería: hover zoom sutil ---------- */
      .gallery-item:hover img {
        transform: scale(1.04);
      }

      /* ---------- Lightbox ---------- */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(5, 5, 10, 0.94);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        padding: 2rem;
      }

      .lightbox.open {
        display: flex;
        animation: lb-fade 0.2s ease;
      }

      .lightbox img {
        max-width: min(92vw, 1400px);
        max-height: 88vh;
        object-fit: contain;
        border-radius: 0.5rem;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
        animation: lb-zoom 0.25s ease;
        user-select: none;
      }

      @keyframes lb-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @keyframes lb-zoom {
        from { transform: scale(0.94); opacity: 0; }
        to   { transform: scale(1);    opacity: 1; }
      }

      .lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .lightbox-close:hover {
        background: rgba(255, 255, 255, 0.16);
        transform: scale(1.06);
      }

      .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .lightbox-nav:hover {
        background: rgba(255, 255, 255, 0.16);
        transform: translateY(-50%) scale(1.06);
      }

      .lightbox-prev { left: 1.5rem; }
      .lightbox-next { right: 1.5rem; }

      .lightbox-counter {
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: rgba(255, 255, 255, 0.7);
        padding: 0.35rem 0.9rem;
        background: rgba(0, 0, 0, 0.55);
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      body.lightbox-open {
        overflow: hidden;
      }

      @media (max-width: 640px) {
        .lightbox { padding: 1rem; }
        .lightbox-nav { width: 40px; height: 40px; }
        .lightbox-prev { left: 0.5rem; }
        .lightbox-next { right: 0.5rem; }
        .lightbox-close { top: 0.75rem; right: 0.75rem; width: 38px; height: 38px; }
        .lightbox img { max-width: 96vw; max-height: 82vh; }
      }
    </style>
  </body>
</html>